# ==============================================================================
# 9Router Environment Configuration Template
# ==============================================================================
# Sao chép file này thành `.env` trước khi khởi động ứng dụng:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME
# ------------------------------------------------------------------------------
PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production

# Base URL dùng cho nội bộ & OAuth / OIDC / SAML callbacks.
# Nếu chạy sau reverse proxy (Nginx, Traefik, Cloudflare), đặt domain thực tế (ví dụ: https://ai.example.com).
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (BẮT BUỘC ĐỔI TRÊN PRODUCTION)
# ------------------------------------------------------------------------------
# Khóa bí mật ký JWT session cookie (dùng chuỗi ngẫu nhiên dài >= 32 ký tự)
JWT_SECRET=change-me-to-a-long-random-secret

# Mật khẩu khởi tạo cho Dashboard (sẽ được yêu cầu đổi sau lần đăng nhập đầu tiên)
INITIAL_PASSWORD=change-me

# Salt mã hóa API key nội bộ và Machine ID
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt

# Bật 'true' nếu chạy sau HTTPS để cookie được gắn flag Secure & SameSite chặt chẽ
AUTH_COOKIE_SECURE=false

# Bật 'true' nếu đứng sau Reverse Proxy tin cậy (Nginx/Cloudflare) để lấy đúng Client IP từ X-Forwarded-For
TRUST_PROXY=false

# Bắt buộc request /v1/* phải kèm Header `Authorization: Bearer <API_KEY>` (tạo trong Dashboard)
REQUIRE_API_KEY=false

# ------------------------------------------------------------------------------
# 3. DATABASE BACKEND (SUPABASE / POSTGRESQL / SQLITE)
# ------------------------------------------------------------------------------
# [MẶC ĐỊNH] Nếu để trống SUPABASE_DB_URL, 9Router sẽ dùng SQLite cục bộ lưu tại DATA_DIR.
# DATA_DIR: Mặc định là ~/.9router (Linux/macOS) hoặc %APPDATA%/9router (Windows).
# Trong container Docker, mặc định là /app/data.
DATA_DIR=/var/lib/9router

# [SUPABASE / POSTGRESQL] Khuyên dùng cho Multi-instance / Cloud Deployment.
# Khi đặt biến này, 9Router tự động tắt SQLite và chạy 100% trên Postgres.
#
# LƯU Ý KHI DÙNG SUPABASE:
# - Vào Project Settings > Database > Connection string > Chọn tab "Transaction pooler" (port 6543).
# - KHÔNG dùng direct port 5432 trên server chạy liên tục để tránh cạn connection.
# - DB chứa token OAuth và API key, giữ DB private, không share anon key ra ngoài.
# - Để migrate data cũ từ SQLite sang Supabase, chạy:
#     node scripts/db-copy-to-postgres.mjs
#
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DATABASE_URL=                         # Alias dự phòng nếu không đặt SUPABASE_DB_URL

# Cấu hình Connection Pool cho PostgreSQL
PGPOOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=15000

# Bỏ qua xác thực chứng chỉ TLS (CHỈ dùng khi chạy Postgres self-hosted nội bộ có CA riêng)
# PGSSL_NO_VERIFY=1

# ------------------------------------------------------------------------------
# 4. OBSERVABILITY & REQUEST LOGS
# ------------------------------------------------------------------------------
# Ghi nhận chi tiết request / response (bảng requestDetails) để xem lại trong Dashboard
OBSERVABILITY_ENABLED=true
OBSERVABILITY_MAX_RECORDS=5000
OBSERVABILITY_BATCH_SIZE=20
OBSERVABILITY_FLUSH_INTERVAL_MS=2000
OBSERVABILITY_MAX_JSON_SIZE=5

# Xuất log thô ra file text dưới thư mục logs/ (chỉ nên bật khi cần debug translator)
ENABLE_REQUEST_LOGS=false

# ------------------------------------------------------------------------------
# 5. OUTBOUND PROXY (TÙY CHỌN CHO UPSTREAM CALLS)
# ------------------------------------------------------------------------------
# Định tuyến các request gọi ra AI provider qua proxy (hỗ trợ HTTP, HTTPS, SOCKS5)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
# STRICT_SSL=true

# ------------------------------------------------------------------------------
# 6. EXTERNAL PROVIDERS & SERVICES (TÙY CHỌN)
# ------------------------------------------------------------------------------
# Endpoint SearXNG cho provider tìm kiếm web không cần API key
# SEARXNG_URL=http://searxng:8080/search

# Headroom context engine URL
# HEADROOM_URL=http://localhost:8787

# ------------------------------------------------------------------------------
# 7. CLOUD SYNC (TÙY CHỌN - ĐỒNG BỘ 9ROUTER CLOUD)
# ------------------------------------------------------------------------------
CLOUD_URL=https://9router.com
NEXT_PUBLIC_CLOUD_URL=https://9router.com
